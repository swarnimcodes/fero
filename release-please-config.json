{
	"prerelease": true,
	"packages": {
		".": {
			"release-type": "simple"
		}
	},
	"extra-files": [
		{
			"type": "toml",
			"path": "fero-core/Cargo.toml",
			"jsonpath": "package.version"
		},
		{
			"type": "toml",
			"path": "fero-core/Cargo.lock",
			"jsonpath": "$.package[?(@.name.value == 'fero_core')].version"
		},
		{
			"type": "toml",
			"path": "app/main/src-tauri/Cargo.toml",
			"jsonpath": "package.version"
		},
		{
			"type": "toml",
			"path": "app/main/src-tauri/Cargo.lock",
			"jsonpath": "$.package[?(@.name.value == 'fero_core')].version"
		},
		{
			"type": "toml",
			"path": "app/main/src-tauri/Cargo.lock",
			"jsonpath": "$.package[?(@.name.value == 'fero')].version"
		},
		{
			"type": "yaml",
			"path": "snap/snapcraft.yaml",
			"jsonpath": "$.version"
		}
	],
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json"
}